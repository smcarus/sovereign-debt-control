# =============================================================================
# Sovereign Fiscal & Debt Control Tower - Environment Configuration
# =============================================================================

# Federal Reserve Economic Data (FRED) API Key
# Request free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
# Used to ingest real-time 10Y/2Y US Treasury yields (GS10, DGS2), SOFR, VIX, and HY credit spreads (BAMLH0A0HYM2).
FRED_API_KEY=""
VITE_FRED_API_KEY=""

# Local Ollama LLM Inference Core (Internal Docker network or host)
# Default Docker network endpoint: http://ollama:11434
# Default Localhost endpoint: http://localhost:11434
OLLAMA_HOST="http://localhost:11434"
VITE_OLLAMA_HOST="http://localhost:11434"
VITE_OLLAMA_MODEL="llama3.1:70b-instruct-q4_K_M"

# PostgreSQL 16 & TimescaleDB Database Connection
DATABASE_URL="postgresql://postgres:sovereign_secret@localhost:5432/sovereign_db"

# Public Macroeconomic & Debt Data Endpoints
VITE_WORLDBANK_API_BASE="https://api.worldbank.org/v2"
VITE_DBNOMICS_API_BASE="https://api.db.nomics.world/v22"
VITE_IMF_API_BASE="https://dataservices.imf.org/REST/SDMX_JSON.svc"

# Application URL & Port
PORT=3000
APP_URL="http://localhost:3000"
